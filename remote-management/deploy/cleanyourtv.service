[Unit]
Description=CleanYourTV persistent signed task queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cleanyourtv
Group=cleanyourtv
WorkingDirectory=/opt/cleanyourtv/remote-management
Environment=PROJECTOR_CONFIG=/etc/cleanyourtv/broker.json
Environment=PROJECTOR_DATA=/var/lib/cleanyourtv
ExecStart=/opt/cleanyourtv/.venv/bin/gunicorn --bind 127.0.0.1:8765 --workers 2 --threads 2 --timeout 60 --umask 0077 --access-logfile /dev/null wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=cleanyourtv
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cleanyourtv
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
