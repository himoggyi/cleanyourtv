name: Projector task relay
on:
  workflow_dispatch:
    inputs:
      task:
        description: 'Strict JSON: {"device":"x5pro","op":"status","args":{}}'
        required: true
        type: string
permissions:
  contents: read
jobs:
  relay:
    if: github.repository == 'himoggyi/cleanyourtv' && github.event.sender.id == 143339177
    runs-on: ubuntu-latest
    timeout-minutes: 3
    # Defaults to human review. Owner may explicitly enable one-time delegated wallpaper control.
    # Both environments must restrict deployment to main. Only projector-wallpaper omits per-task reviewers.
    environment: ${{ vars.PROJECTOR_AUTOMATIC_WALLPAPER == 'true' && fromJSON(inputs.task).op == 'apply_wallpaper' && 'projector-wallpaper' || 'projector-control' }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: main
          persist-credentials: false
      - name: Install pinned image validation dependencies
        run: python3 -m pip install --disable-pip-version-check -r remote-management/requirements.txt
      - name: Validate, sign and enqueue
        env:
          OWNER_ID: '143339177'
          ALLOWED_OPERATION: ${{ vars.PROJECTOR_AUTOMATIC_WALLPAPER == 'true' && fromJSON(inputs.task).op == 'apply_wallpaper' && 'apply_wallpaper' || '' }}
          BROKER_URL: ${{ vars.PROJECTOR_BROKER_URL }}
          BROKER_WRITER_TOKEN: ${{ secrets.PROJECTOR_BROKER_WRITER_TOKEN }}
          TASK_SIGNING_KEY: ${{ secrets.PROJECTOR_TASK_SIGNING_KEY }}
        run: python3 remote-management/relay.py
