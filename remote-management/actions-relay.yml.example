name: Projector task relay
on:
  workflow_dispatch:
    inputs:
      task:
        description: 'Strict JSON: {"device":"x5pro","op":"status","args":{}}'
        required: true
        type: string
permissions:
  contents: read
jobs:
  relay:
    if: github.repository == 'himoggyi/cleanyourtv' && github.event.sender.id == 143339177
    runs-on: ubuntu-latest
    timeout-minutes: 3
    # Configure required reviewers and only main deployment branch BEFORE activation.
    # Prototype requires explicit approval for EVERY task, including harmless ones.
    environment: projector-control
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: main
          persist-credentials: false
      - name: Validate, sign and enqueue
        env:
          OWNER_ID: '143339177'
          BROKER_URL: ${{ vars.PROJECTOR_BROKER_URL }}
          BROKER_WRITER_TOKEN: ${{ secrets.PROJECTOR_BROKER_WRITER_TOKEN }}
          TASK_SIGNING_KEY: ${{ secrets.PROJECTOR_TASK_SIGNING_KEY }}
        run: python3 remote-management/relay.py
